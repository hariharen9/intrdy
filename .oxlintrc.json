{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error",
    "import/no-relative-parent-imports": "error",
    "import/no-duplicates": "error",
    "import/no-unassigned-import": "off",
    "import/first": "error",
    "import/newline-after-import": "error",
    "typescript/consistent-type-imports": "error",

    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^@/(shared|entities|features|widgets|pages|app)/[^/]+/",
            "message": "Deep import: reach for the slice's public API (e.g. '@/shared/ui') instead of its internals."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/shared/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/(app|pages|widgets|features|entities)",
                "message": "Boundary violation: 'shared' cannot import from other layers."
              },
              {
                "regex": "^@/(shared|entities|features|widgets|pages|app)/[^/]+/",
                "message": "Deep import: reach for the slice's public API instead of its internals."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/entities/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/(app|pages|widgets|features)",
                "message": "Boundary violation: 'entities' may only be imported by upper layers."
              },
              {
                "regex": "^@/(shared|entities|features|widgets|pages|app)/[^/]+/",
                "message": "Deep import: reach for the slice's public API instead of its internals."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/(app|pages|widgets)",
                "message": "Boundary violation: only 'app', 'pages' and 'widgets' may import 'features'."
              },
              {
                "regex": "^@/(shared|entities|features|widgets|pages|app)/[^/]+/",
                "message": "Deep import: reach for the slice's public API instead of its internals."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/widgets/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/(app|pages)",
                "message": "Boundary violation: 'widgets' may not import 'app' or 'pages'."
              },
              {
                "regex": "^@/(shared|entities|features|widgets|pages|app)/[^/]+/",
                "message": "Deep import: reach for the slice's public API instead of its internals."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pages/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/app",
                "message": "Boundary violation: only 'app' may import 'app'."
              },
              {
                "regex": "^@/(shared|entities|features|widgets|pages|app)/[^/]+/",
                "message": "Deep import: reach for the slice's public API instead of its internals."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules"]
}
